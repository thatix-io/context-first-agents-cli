{
  "name": "@thatix.io/context-first-agents-cli",
  "version": "0.4.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Evolution of context-first-cli: manage the Context-First methodology across any project AND orchestrate dynamic, ephemeral AI agents from specs. All agent orchestration lives in .md command templates; the Node layer only scaffolds and manages.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thatix-io/context-first-agents-cli.git"
  },
  "bugs": {
    "url": "https://github.com/thatix-io/context-first-agents-cli/issues"
  },
  "homepage": "https://github.com/thatix-io/context-first-agents-cli#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "context-agents": "./dist/index.js",
    "cfa": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "copy-templates": "node ./scripts/copy-templates.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "context-first",
    "cli",
    "ai-agents",
    "orchestrator",
    "worktree",
    "spec-driven",
    "dynamic-agents",
    "ephemeral-agents",
    "methodology",
    "ai-assisted"
  ],
  "author": "Thiago Abreu <thiagoabreu.dev>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "inquirer": "^13.2.0",
    "simple-git": "^3.30.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.0.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
